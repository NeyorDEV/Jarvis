{
  "manifest_version": 2,
  "name": "JARVIS Web Controller",
  "version": "1.0",
  "description": "Contrôle vocal et curseur virtuel par le DOM pour JARVIS.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
